{
  "name": "restaurantapp",
  "main": "expo-router/entry",
  "version": "5.0.0",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--max-old-space-size=4096 EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 expo start",
    "start:clean": "cross-env NODE_OPTIONS=--max-old-space-size=4096 EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 expo start -c",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "cross-env NODE_OPTIONS=--max-old-space-size=4096 EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 expo run:android",
    "ios": "cross-env NODE_OPTIONS=--max-old-space-size=4096 EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 expo run:ios",
    "web": "cross-env NODE_OPTIONS=--max-old-space-size=4096 EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 expo start --web",
    "build:web": "cross-env NODE_OPTIONS=--max-old-space-size=4096 EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 expo export --platform web",
    "build:customer-display-web": "cross-env NODE_OPTIONS=--max-old-space-size=4096 EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 expo export --platform web --output-dir ../print-bridge/customer-display-web",
    "postinstall": "node ./scripts/fix-jcenter.js",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@unipro/customer-display": "file:../packages/customer-display",
    "ajv": "^8.18.0",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.15.2",
    "babel-preset-expo": "~57.0.0",
    "date-fns": "^3.0.0",
    "dotenv": "^16.0.0",
    "expo": "~57.0.24",
    "expo-av": "^16.0.8",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.19",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.2",
