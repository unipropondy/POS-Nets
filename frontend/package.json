    "expo-modules-core": "~57.0.18",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-screen-orientation": "~57.0.2",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-external-display": "^0.6.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-gifted-charts": "^1.4.10",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-thermal-printer": "^2.3.6",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "react-native-worklets-core": "^1.6.3",
    "socket.io-client": "^4.7.5",
    "sunmi-printer-expo": "^1.0.0",
